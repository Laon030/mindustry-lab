# Execute after duel_gate5_fixture.console on a paused world.
# Symmetric pre-match source vaults hold finite silicon/lead; factories start empty.
# The unloader transfers items only during gameplay after a model selects PRODUCE.
js for(let cy of [52,132]){let team=cy==52?Team.sharded:Team.crux;Vars.world.tile(151,cy+3).setBlock(Blocks.largeSolarPanel,team,0);Vars.world.tile(151,cy+6).setBlock(Blocks.groundFactory,team,2);Vars.world.tile(155,cy+6).setBlock(Blocks.vault,team,0);Vars.world.tile(153,cy+6).setBlock(Blocks.unloader,team,0);let factory=Vars.world.tile(151,cy+6).build,reserve=Vars.world.tile(155,cy+6).build;factory.currentPlan=-1;reserve.items.add(Items.silicon,10);reserve.items.add(Items.lead,10);print('DEMO_SUPPLY_READY team='+team.name+' factory='+factory.block.name+' rotation='+factory.rotation+' factoryStock='+factory.items.get(Items.silicon)+'/'+factory.items.get(Items.lead)+' reserve='+reserve.items.get(Items.silicon)+'/'+reserve.items.get(Items.lead)+' unloader='+Vars.world.tile(153,cy+6).block().name)}
